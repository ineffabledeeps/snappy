# Optional: require Authorization: Bearer <API_SECRET>
API_SECRET=

# Optional: Cloudinary upload (needed when response=url)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

CORS_ORIGIN=*

# Required on Vercel for @sparticuz/chromium shared libs
AWS_LAMBDA_JS_RUNTIME=nodejs22.x
